{
  "name": "@dangbt/pro-ui",
  "version": "1.11.0",
  "type": "module",
  "description": "React UI component library built on React Aria Components + Tailwind CSS v4",
  "keywords": [
    "react",
    "ui",
    "components",
    "tailwind",
    "react-aria"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dangbt/pro-ui.git"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/components/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./tailwind.css": "./tailwind.css",
    "./theme.css": "./theme.css"
  },
  "files": [
    "dist",
    "src",
    "tailwind.css",
    "theme.css"
  ],
  "sideEffects": false,
  "registry": "https://pro-ui.pages.dev/registry.json",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist/server && node prerender.mjs",
    "build:lib": "vite build -c vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "prepublishOnly": "pnpm build:lib",
    "preview": "vite preview",
    "tools:build": "pnpm -r --filter './tools/**' build",
    "tools:publish": "pnpm -r --filter './tools/**' publish --no-git-checks",
    "gen:llms": "node generate-llms-full.mjs",
    "gen:registry": "node generate-registry.mjs",
    "mcp:dev": "pnpm --filter mcp-pro-ui dev",
    "cli:dev": "pnpm --filter create-pro-ui-app dev",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "@hookform/resolvers": ">=3",
    "@internationalized/date": ">=3",
    "@tanstack/react-table": "^8.21.0",
    "@types/react": ">=18",
    "lucide-react": ">=0.400.0",
    "react": ">=18",
    "react-aria-components": ">=1.21.0",
    "react-dom": ">=18",
    "react-hook-form": ">=7",
    "tailwindcss": ">=4",
    "zod": ">=3"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "dependencies": {
    "clsx": "2.1.1",
    "tailwind-merge": "3.3.1",
    "tailwindcss-react-aria-components": "2.2.0"
  },
  "devDependencies": {
    "@hookform/resolvers": "5.9.0",
    "@internationalized/date": "3.12.4",
    "@resvg/resvg-js": "^2.6.2",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-table": "8.21.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "lucide-react": "1.49.0",
    "playwright": "1.63.0",
    "react": "19.2.6",
    "react-aria-components": "1.21.1",
    "react-dom": "19.2.6",
    "react-hook-form": "7.89.0",
    "storybook": "^10.6.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vite-plugin-dts": "5.1.0",
    "vitest": "5.0.3",
    "zod": "4.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
